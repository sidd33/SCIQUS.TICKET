## .NET / C# gitignore

# Build output
bin/
obj/

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/
project.lock.json
project.nuget.cache
*.nuget.props
*.nuget.targets

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser

# Rider
.idea/

# VS Code
.vscode/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# ASP.NET
wwwroot/dist/

# Secrets — never commit these
appsettings.Development.json
# Comment out the line below if you want to share appsettings.json with team
# appsettings.json

# EF migrations snapshot is OK to commit, but not the compiled output
# Local environment folders
.dotnet-home/
.tmp/
